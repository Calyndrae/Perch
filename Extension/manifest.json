{
  "manifest_version": 3,
  "name": "Perch Bridge",
  "version": "0.9.0",
  "description": "Companion to Perch.app. Screen-share requests get the page's own tab instead of your screen, and exit-intent popups are blocked.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "110"
}
